# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_risk_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pr_risk_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pr_risk_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# GitHub App Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=development-webhook-secret

# AI Layer (Optional - runs deterministic intelligence offline without key)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
